[Unit]
Description=SOUQRATES scratchy-bot (Telegram, webhook on :8105)
After=network-online.target souqrates-api.service
Wants=network-online.target

[Service]
Type=simple
User=souqrates
Group=souqrates
WorkingDirectory=/opt/souqrates/repo/artifacts/scratchy-bot/src
EnvironmentFile=/etc/souqrates/scratchy-bot.env
ExecStart=/opt/souqrates/venvs/scratchy-bot/bin/python -u bot.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=souqrates-scratchy-bot

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
