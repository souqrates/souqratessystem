[Unit]
Description=SOUQRATES mother-bot (Telegram, webhook on :8101)
After=network-online.target souqrates-api.service
Wants=network-online.target

[Service]
Type=simple
User=souqrates
Group=souqrates
WorkingDirectory=/opt/souqrates/repo/artifacts/mother-bot/src
EnvironmentFile=/etc/souqrates/mother-bot.env
ExecStart=/opt/souqrates/venvs/mother-bot/bin/python -u bot.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=souqrates-mother-bot

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
