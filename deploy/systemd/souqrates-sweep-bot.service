[Unit]
Description=SOUQRATES sweep-bot (Telegram, webhook on :8105)
After=network-online.target souqrates-api.service
Wants=network-online.target

[Service]
Type=simple
User=souqrates
Group=souqrates
WorkingDirectory=/opt/souqrates/repo/artifacts/sweep-bot/src
EnvironmentFile=/etc/souqrates/sweep-bot.env
ExecStart=/opt/souqrates/venvs/sweep-bot/bin/python -u bot.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=souqrates-sweep-bot

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
