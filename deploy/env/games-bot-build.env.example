# /etc/souqrates/games-bot-build.env
# chmod 600. Read by deploy.sh at BUILD TIME to bake Supabase config into the
# games-bot static bundle. Vite inlines VITE_* vars at compile time — if this
# file is missing, ranks / XP / daily streak / achievements are all disabled.
#
# Values come from your Supabase project → Settings → API.
# These are PUBLIC keys (anon key has RLS enforced) — safe to store here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.__YOUR_ANON_KEY__
