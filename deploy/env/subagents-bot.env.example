# /etc/souqrates/subagents-bot.env
# chmod 600. Loaded by systemd.

SUBAGENTS_BOT_TOKEN=__FROM_BOTFATHER__
SUBAGENTS_BOT_API_KEY=__SAME_AS_API_SERVER_ENV__
MOTHER_API_URL=http://127.0.0.1:8080/api
MOTHER_BOT_USERNAME=__YOUR_MOTHER_BOT_USERNAME_WITHOUT_AT__
PUBLIC_BASE_URL=https://souqrates.com

USE_WEBHOOK=1
WEBHOOK_BASE_URL=https://souqrates.com
WEBHOOK_SECRET=__RANDOM_32_PLUS_CHARS__
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8104

SENTRY_DSN=
