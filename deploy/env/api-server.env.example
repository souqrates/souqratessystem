# /etc/souqrates/api-server.env
# Copy to that path on the VPS and chmod 600. Loaded by systemd EnvironmentFile.

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Neon Postgres (Frankfurt). Use the pooled connection string for app traffic.
DATABASE_URL=postgresql://USER:PASS@ep-XXXX-pooler.eu-central-1.aws.neon.tech/souqrates?sslmode=require

# Sessions / encryption-at-rest for integration secrets.
# Rotating this invalidates every saved integration config — by design.
SESSION_SECRET=__REPLACE_WITH_64_RANDOM_BYTES_HEX__

# Super-admin bearer token (used by the React panel and CLI).
ADMIN_TOKEN=__REPLACE_WITH_LONG_RANDOM__
MASTER_ADMIN_CODE=__REPLACE_WITH_LONG_RANDOM__

# Cloudflare R2 (S3-compatible). Setting S3_ENDPOINT activates the R2 backend
# in artifacts/api-server/src/lib/objectStorage.ts.
S3_ENDPOINT=https://fbdc242872a8b998c83e4dea16cc2154.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=__YOUR_R2_BUCKET_NAME__
S3_ACCESS_KEY=__R2_ACCESS_KEY__
S3_SECRET_KEY=__R2_SECRET_KEY__
PRIVATE_OBJECT_DIR=/__YOUR_R2_BUCKET_NAME__/private
PUBLIC_OBJECT_SEARCH_PATHS=/__YOUR_R2_BUCKET_NAME__/public

# Telegram Stars payments + on-chain TON deposits
TON_API_KEY=__TONCENTER_KEY__
TON_WALLET_ADDRESS=__YOUR_TON_ADDRESS__

# Cryptomus (USDT) — optional, only if enabled in admin panel
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_PAYMENT_API_KEY=
CRYPTOMUS_PAYOUT_API_KEY=
CRYPTOMUS_WEBHOOK_SECRET=

# Email (Resend) — optional
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry — optional but recommended
SENTRY_DSN=

# Cloudflare Turnstile (captcha) — optional for public web forms
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Upstash Redis — used by per-user rate limiter; without it, limiter falls
# back to in-memory (per-process, fine for single api-server box)
UPSTASH_REST_URL=
UPSTASH_REST_TOKEN=

# Cloudflare API (for the integrations panel — DNS/WAF actions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Telegram bot tokens — required by the API server to validate Telegram
# initData signatures (Mini App auth). Must match the tokens in each bot's
# own env file.
MOTHER_BOT_TOKEN=__FROM_BOTFATHER__
GAMES_BOT_TOKEN=__FROM_BOTFATHER__
BOOKS_BOT_TOKEN=__FROM_BOTFATHER__
CONTESTS_BOT_TOKEN=__FROM_BOTFATHER__
SUBAGENTS_BOT_TOKEN=__FROM_BOTFATHER__

# Per-bot API keys (the mother-bot + child bots each get one row in `bots`).
# Generate fresh ones — DO NOT reuse the Replit values.
MOTHER_BOT_API_KEY=__REGENERATE__
BOOKS_BOT_API_KEY=__REGENERATE__
CONTESTS_BOT_API_KEY=__REGENERATE__
SUBAGENTS_BOT_API_KEY=__REGENERATE__
GAMES_BOT_API_KEY=__REGENERATE__
