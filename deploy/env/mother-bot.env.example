# /etc/souqrates/mother-bot.env
# chmod 600. Loaded by systemd.

MOTHER_BOT_TOKEN=__FROM_BOTFATHER__
MOTHER_BOT_API_KEY=__SAME_AS_API_SERVER_ENV__
MOTHER_API_URL=http://127.0.0.1:8080/api
MASTER_ADMIN_CODE=__SAME_AS_API_SERVER_ENV__
PUBLIC_BASE_URL=https://souqrates.com

# Webhook mode
USE_WEBHOOK=1
WEBHOOK_BASE_URL=https://souqrates.com
WEBHOOK_SECRET=__RANDOM_32_PLUS_CHARS__
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8101

# Mother-bot must NOT fork-launch the subagents-bot on VPS;
# subagents-bot has its own systemd service.
DISABLE_SUBAGENTS_SPAWN=1

# Sentry (optional)
SENTRY_DSN=
