# SPA-friendly Caddy config used inside each web container.
# Serves /srv and falls back to index.html for client-side routing.
:80 {
    root * /srv
    encode zstd gzip
    try_files {path} /index.html
    file_server
    header {
        # cache hashed assets aggressively
        ?Cache-Control "public, max-age=31536000, immutable"
        # but never cache index.html
        Cache-Control "no-cache, no-store, must-revalidate"
    }
    @hashed path *.js *.css *.woff2 *.png *.jpg *.jpeg *.webp *.svg *.gif
    header @hashed Cache-Control "public, max-age=31536000, immutable"
}
