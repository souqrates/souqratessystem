# ════════════════════════════════════════════════════════════════════════
#  SOUQRATES SYSTEM — production environment
#  Copy this to `.env` on the server and fill every value.
#  NEVER commit .env to git. NEVER share it.
# ════════════════════════════════════════════════════════════════════════

# ── Operations ──────────────────────────────────────────────────────────
TZ=Asia/Beirut
ACME_EMAIL=admin@souqrates.com          # Let's Encrypt notifications

# ── Domains (set in Cloudflare DNS to point to this VPS IP) ─────────────
DOMAIN_API=api.souqrates.com
DOMAIN_ADMIN=admin.souqrates.com
DOMAIN_BOOKS=books.souqrates.com
DOMAIN_CONTESTS=contests.souqrates.com
DOMAIN_GAMES=games.souqrates.com
DOMAIN_SUBAGENTS=subagents.souqrates.com
DOMAIN_WEBHOOK=tg.souqrates.com         # Telegram webhook endpoint

# Public URL used by bots when building Mini App links
PUBLIC_BASE_URL=https://api.souqrates.com

# ── Database (Neon) ─────────────────────────────────────────────────────
# Grab from neon.tech → project → Connection string (pooled)
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/souqrates?sslmode=require

# ── Object Storage (Cloudflare R2) ──────────────────────────────────────
# Create R2 bucket at dash.cloudflare.com → R2 → Create bucket
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=souqrates-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ── Telegram bot tokens (same tokens used on Replit — DO NOT regenerate) ─
MOTHER_BOT_TOKEN=
GAMES_BOT_TOKEN=
CONTESTS_BOT_TOKEN=
SUBAGENTS_BOT_TOKEN=
BOOKS_BOT_TOKEN=
VIDEO_BOT_TOKEN=
VOICE_BOT_TOKEN=

# ── Internal bot API keys (same as Replit — copy from `bots` table) ─────
MOTHER_BOT_API_KEY=
GAMES_BOT_API_KEY=
CONTESTS_BOT_API_KEY=
SUBAGENTS_BOT_API_KEY=
BOOKS_BOT_API_KEY=

# ── Admin / sessions ────────────────────────────────────────────────────
ADMIN_TOKEN=
MASTER_ADMIN_CODE=
SESSION_SECRET=                          # 32+ random bytes; rotating invalidates integrations
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Payments ────────────────────────────────────────────────────────────
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_PAYMENT_API_KEY=
CRYPTOMUS_PAYOUT_API_KEY=
CRYPTOMUS_WEBHOOK_SECRET=
TON_API_KEY=
TON_WALLET_ADDRESS=

# ── Captcha / security ──────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── Observability (already external) ────────────────────────────────────
SENTRY_DSN=
UPSTASH_REST_URL=
UPSTASH_REST_TOKEN=

# ── Cloudflare (for DNS automation, optional) ───────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
